+func TestEmit_HTTPHookCustomHeadersPreserveProtocolHeaders(t *testing.T) {
+	type observedRequest struct {
+		headers http.Header
+		body    HookEvent
+	}
+	observed := make(chan observedRequest, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var event HookEvent
+		if err := json.NewDecoder(r.Body).Decode(&event); err != nil {
+			http.Error(w, "invalid body", http.StatusBadRequest)
+			return
+		}
+		observed <- observedRequest{headers: r.Header.Clone(), body: event}
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	hm := NewHookManager("headers-test", []HookConfig{{
+		Event: "message.received",
+		Type:  "http",
+		URL:   server.URL,
+		Async: boolPtr(false),
+		Headers: map[string]string{
+			"Authorization": "Bearer dummy-hook-token",
+			"Content-Type":  "text/plain",
+			"User-Agent":    "custom-agent",
+			"X-Hook-Event":  "spoofed.event",
+		},
+	}}, "sh", "-c", "")
+	hm.Emit(HookEvent{Event: HookEventMessageReceived, Content: "hello"})
+
+	got := <-observed
+	if value := got.headers.Get("Authorization"); value != "Bearer dummy-hook-token" {
+		t.Fatalf("Authorization = %q", value)
+	}
+	if value := got.headers.Get("Content-Type"); value != "application/json" {
+		t.Fatalf("Content-Type = %q", value)
+	}
+	if value := got.headers.Get("User-Agent"); value != "CC-Connect-Hooks/1.0" {
+		t.Fatalf("User-Agent = %q", value)
+	}
+	if value := got.headers.Get("X-Hook-Event"); value != "message.received" {
+		t.Fatalf("X-Hook-Event = %q", value)
+	}
+	if got.body.Project != "headers-test" || got.body.Content != "hello" {
+		t.Fatalf("event = %#v", got.body)
+	}
+}
