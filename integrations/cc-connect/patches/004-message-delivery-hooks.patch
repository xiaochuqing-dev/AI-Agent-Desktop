+// TestSendRecordsMessageID verifies that Send captures the returned Telegram
+// message_id via the SentMessageRecorder interface, so the engine can emit
+// message.sent_delivered for the governance Transcript.
+func TestSendRecordsMessageID(t *testing.T) {
+	p := &Platform{
+		bot:      newStubTelegramBot(),
+		selfUser: &models.User{ID: 1, Username: "testbot"},
+	}
+	rc := replyContext{chatID: 42, threadID: 7, messageID: 10}
+
+	if err := p.Send(context.Background(), rc, "hello"); err != nil {
+		t.Fatalf("Send: %v", err)
+	}
+
+	id, chatID, threadID, ok := p.LastSentMessageID()
+	if !ok {
+		t.Fatal("LastSentMessageID: expected ok=true after Send")
+	}
+	if id != "99" {
+		t.Fatalf("sent id = %q, want 99", id)
+	}
+	if chatID != "42" {
+		t.Fatalf("chatID = %q, want 42", chatID)
+	}
+	if threadID != "7" {
+		t.Fatalf("threadID = %q, want 7", threadID)
+	}
+
+	// ClearLastSent should reset so a stale value is never read twice.
+	p.ClearLastSent()
+	if _, _, _, ok := p.LastSentMessageID(); ok {
+		t.Fatal("expected ok=false after ClearLastSent")
+	}
+}
