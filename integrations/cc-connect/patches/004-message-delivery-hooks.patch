+func TestDeliveryReportingDirectFallbackAndFailure(t *testing.T) {
+	rc := replyContext{chatID: 42, threadID: 7, messageID: 10}
+
+	directBot := newScriptedDeliveryBot(101)
+	direct, directCapture := deliveryPlatform(directBot)
+	if err := direct.Reply(context.Background(), rc, "hello"); err != nil {
+		t.Fatalf("Reply: %v", err)
+	}
+	got := directCapture.get()
+	if len(got) != 1 || got[0].MessageID != "101" || got[0].ChatID != "42" || got[0].ThreadID != "7" || got[0].Content != "hello" {
+		t.Fatalf("direct deliveries = %#v", got)
+	}
+
+	fallbackBot := newScriptedDeliveryBot(0,
+		scriptedSendResult{err: errors.New("can't parse entities")},
+		scriptedSendResult{id: 202},
+	)
+	fallback, fallbackCapture := deliveryPlatform(fallbackBot)
+	if err := fallback.Send(context.Background(), rc, "fallback"); err != nil {
+		t.Fatalf("Send fallback: %v", err)
+	}
+	got = fallbackCapture.get()
+	if len(got) != 1 || got[0].MessageID != "202" || got[0].Content != "fallback" {
+		t.Fatalf("fallback deliveries = %#v", got)
+	}
+
+	failingBot := newScriptedDeliveryBot(0, scriptedSendResult{err: errors.New("network unavailable")})
+	failing, failingCapture := deliveryPlatform(failingBot)
+	if err := failing.Send(context.Background(), rc, "not delivered"); err == nil {
+		t.Fatal("Send should fail")
+	}
+	if got := failingCapture.get(); len(got) != 0 {
+		t.Fatalf("failed send reported delivery: %#v", got)
+	}
+}
