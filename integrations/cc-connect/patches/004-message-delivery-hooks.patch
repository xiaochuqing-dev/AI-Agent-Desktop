+
+	"github.com/chenhg5/cc-connect/core"
+	tgbot "github.com/go-telegram/bot"
+	"github.com/go-telegram/bot/models"
+)
+
+type scriptedSendResult struct {
+	id  int
+	err error
+}
+
+type scriptedDeliveryBot struct {
+	*stubTelegramBot
+	mu       sync.Mutex
+	results  []scriptedSendResult
+	nextID   int
+	callText map[int]string
+}
+
+func newScriptedDeliveryBot(nextID int, results ...scriptedSendResult) *scriptedDeliveryBot {
+	return &scriptedDeliveryBot{
+		stubTelegramBot: newStubTelegramBot(),
+		results:         append([]scriptedSendResult(nil), results...),
+		nextID:          nextID,
+		callText:        make(map[int]string),
+	}
+}
+
+func (b *scriptedDeliveryBot) SendMessage(_ context.Context, params *tgbot.SendMessageParams) (*models.Message, error) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	var result scriptedSendResult
+	if len(b.results) > 0 {
+		result = b.results[0]
+		b.results = b.results[1:]
+	} else {
+		result.id = b.nextID
+		b.nextID++
+	}
+	if result.err != nil {
+		return nil, result.err
+	}
+	if result.id == 0 {
+		result.id = b.nextID
+		b.nextID++
+	}
+	b.callText[result.id] = params.Text
+	return &models.Message{ID: result.id}, nil
+}
+
+func (b *scriptedDeliveryBot) textFor(id int) string {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	return b.callText[id]
+}
+
+type deliveryCapture struct {
+	mu      sync.Mutex
+	records []core.DeliveredMessage
+}
+
+func (c *deliveryCapture) add(delivery core.DeliveredMessage) {
+	c.mu.Lock()
+	c.records = append(c.records, delivery)
+	c.mu.Unlock()
+}
+
+func (c *deliveryCapture) get() []core.DeliveredMessage {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return append([]core.DeliveredMessage(nil), c.records...)
+}
+
+func deliveryPlatform(bot telegramBot) (*Platform, *deliveryCapture) {
+	capture := &deliveryCapture{}
+	p := &Platform{bot: bot, selfUser: &models.User{ID: 1, Username: "testbot"}}
+	p.SetDeliveryHandler(capture.add)
+	return p, capture
+}
+
+func TestDispatchMessagePopulatesGovernanceMetadata(t *testing.T) {
+	p := &Platform{}
+	var captured *core.Message
+	p.handler = func(_ core.Platform, msg *core.Message) { captured = msg }
+	tgMsg := &models.Message{
+		ID:              999,
+		Chat:            models.Chat{ID: -100123, Type: models.ChatTypeSupergroup},
+		MessageThreadID: 88,
+		From:            &models.User{ID: 2, IsBot: true, Username: "otherbot"},
+		ReplyToMessage:  &models.Message{ID: 555},
+		Text:            "hello",
+	}
+	p.dispatchMessage(&core.Message{MessageID: "999", Content: "hello"}, tgMsg)
+	if captured == nil {
+		t.Fatal("handler was not called")
+	}
+	if captured.ChatID != "-100123" || captured.ThreadID != "88" || captured.ReplyToMessageID != "555" || !captured.SenderIsBot {
+		t.Fatalf("metadata = %#v", captured)
+	}
+}
