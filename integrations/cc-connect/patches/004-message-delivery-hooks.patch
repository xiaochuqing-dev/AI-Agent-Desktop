+
+// TestDispatchMessagePopulatesMetadata verifies dispatchMessage fills the new
+// governance fields (ChatID, ThreadID, ReplyToMessageID, SenderIsBot) on
+// core.Message from the raw Telegram message, so the engine's message.received
+// hook Extra carries them.
+func TestDispatchMessagePopulatesMetadata(t *testing.T) {
+	p := &Platform{
+		bot:      newStubTelegramBot(),
+		selfUser: &models.User{ID: 1, Username: "testbot"},
+	}
+
+	// A human message that replies to a bot message (ID 555) in a forum topic.
+	tgMsg := &models.Message{
+		ID: 999,
+		Chat: models.Chat{
+			ID:   -100123,
+			Type: models.ChatTypeSupergroup,
+		},
+		MessageThreadID: 88,
+		From: &models.User{
+			ID:       1000000001,
+			IsBot:    false,
+			Username: "test_human_user",
+		},
+		Text: "hello @testbot",
+		ReplyToMessage: &models.Message{
+			ID: 555,
+			From: &models.User{ID: 1, IsBot: true, Username: "testbot"},
+			Text: "previous bot reply",
+		},
+	}
+
+	msg := &core.Message{
+		SessionKey: "telegram:-100123:88:1000000001",
+		Platform:   "telegram",
+		MessageID:  "999",
+		Content:    "hello @testbot",
+	}
+
+	// dispatchMessage reads tgMsg; we don't need the handler to fire.
+	var captured *core.Message
+	p.handler = func(_ core.Platform, m *core.Message) {
+		captured = m
+	}
+	// Avoid nil-messageHandler path.
+	p.dispatchMessage(msg, tgMsg)
+
+	if captured == nil {
+		t.Fatal("handler was not called")
+	}
+	if captured.ChatID != "-100123" {
+		t.Fatalf("ChatID = %q, want -100123", captured.ChatID)
+	}
+	if captured.ThreadID != "88" {
+		t.Fatalf("ThreadID = %q, want 88", captured.ThreadID)
+	}
+	if captured.ReplyToMessageID != "555" {
+		t.Fatalf("ReplyToMessageID = %q, want 555", captured.ReplyToMessageID)
+	}
+	if captured.SenderIsBot {
+		t.Fatal("SenderIsBot = true, want false (human sender)")
+	}
+}
