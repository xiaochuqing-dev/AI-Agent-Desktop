@@ -0,0 +1,85 @@
+package core
+
+import (
+	"testing"
+)
+
+// TestMessageReceivedExtra verifies the helper that builds the Extra map for
+// the message.received hook carries the governance metadata fields.
+func TestMessageReceivedExtra(t *testing.T) {
+	t.Run("human message with reply and attachments", func(t *testing.T) {
+		msg := &Message{
+			MessageID:        "999",
+			ChatID:           "-100123",
+			ThreadID:         "88",
+			ReplyToMessageID: "555",
+			SenderIsBot:      false,
+			Images:           []ImageAttachment{{}},
+			Files:            []FileAttachment{{}},
+		}
+		extra := messageReceivedExtra(msg)
+		if extra["message_id"] != "999" {
+			t.Fatalf("message_id = %v, want 999", extra["message_id"])
+		}
+		if extra["chat_id"] != "-100123" {
+			t.Fatalf("chat_id = %v, want -100123", extra["chat_id"])
+		}
+		if extra["thread_id"] != "88" {
+			t.Fatalf("thread_id = %v, want 88", extra["thread_id"])
+		}
+		if extra["reply_to_message_id"] != "555" {
+			t.Fatalf("reply_to_message_id = %v, want 555", extra["reply_to_message_id"])
+		}
+		if extra["sender_type"] != "human" {
+			t.Fatalf("sender_type = %v, want human", extra["sender_type"])
+		}
+		if extra["has_images"] != true {
+			t.Fatalf("has_images = %v, want true", extra["has_images"])
+		}
+		if extra["has_files"] != true {
+			t.Fatalf("has_files = %v, want true", extra["has_files"])
+		}
+	})
+
+	t.Run("bot sender no reply no attachments", func(t *testing.T) {
+		msg := &Message{
+			MessageID:   "100",
+			ChatID:      "-200",
+			SenderIsBot: true,
+		}
+		extra := messageReceivedExtra(msg)
+		if extra["sender_type"] != "bot" {
+			t.Fatalf("sender_type = %v, want bot", extra["sender_type"])
+		}
+		if _, ok := extra["reply_to_message_id"]; ok {
+			t.Fatal("reply_to_message_id should be absent when empty")
+		}
+		if extra["has_images"] != false {
+			t.Fatalf("has_images = %v, want false", extra["has_images"])
+		}
+	})
+
+	t.Run("nil message", func(t *testing.T) {
+		if extra := messageReceivedExtra(nil); extra != nil {
+			t.Fatalf("expected nil for nil message, got %v", extra)
+		}
+	})
+}
+
+// TestMessageSentDeliveredExtra verifies the delivered hook Extra carries the
+// sent message_id and routing context.
+func TestMessageSentDeliveredExtra(t *testing.T) {
+	extra := messageSentDeliveredExtra("telegram:-100:88:123", "telegram", "777", "-100", "88", "text")
+	if extra["message_id"] != "777" {
+		t.Fatalf("message_id = %v, want 777", extra["message_id"])
+	}
+	if extra["chat_id"] != "-100" {
+		t.Fatalf("chat_id = %v, want -100", extra["chat_id"])
+	}
+	if extra["thread_id"] != "88" {
+		t.Fatalf("thread_id = %v, want 88", extra["thread_id"])
+	}
+	if extra["message_type"] != "text" {
+		t.Fatalf("message_type = %v, want text", extra["message_type"])
+	}
+}
