+// TestDispatchMessageBotSender verifies SenderIsBot is set when the sender is a bot.
+func TestDispatchMessageBotSender(t *testing.T) {
+	p := &Platform{
+		bot:      newStubTelegramBot(),
+		selfUser: &models.User{ID: 1, Username: "testbot"},
+	}
+	tgMsg := &models.Message{
+		ID:   100,
+		Chat: models.Chat{ID: -100, Type: models.ChatTypeSupergroup},
+		From: &models.User{ID: 2, IsBot: true, Username: "other_bot"},
+		Text: "a bot message",
+	}
+	msg := &core.Message{SessionKey: "telegram:-100:2", Platform: "telegram", MessageID: "100"}
+	var captured *core.Message
+	p.handler = func(_ core.Platform, m *core.Message) { captured = m }
+	p.dispatchMessage(msg, tgMsg)
+
+	if !captured.SenderIsBot {
+		t.Fatal("SenderIsBot = false, want true (bot sender)")
+	}
+}
