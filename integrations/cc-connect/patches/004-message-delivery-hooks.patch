+func TestChunkedDeliveryReportsEachSuccessfulNativeMessage(t *testing.T) {
+	rc := replyContext{chatID: -100, threadID: 88, messageID: 5}
+	bot := newScriptedDeliveryBot(400, scriptedSendResult{err: errors.New("message is too long")})
+	p, capture := deliveryPlatform(bot)
+	if err := p.Reply(context.Background(), rc, strings.Repeat("x", 9000)); err != nil {
+		t.Fatalf("Reply chunked: %v", err)
+	}
+	got := capture.get()
+	if len(got) < 3 {
+		t.Fatalf("chunk deliveries = %#v", got)
+	}
+	for i, delivery := range got {
+		if delivery.MessageID != strconv.Itoa(400+i) || delivery.PartIndex != i+1 || delivery.PartCount != len(got) {
+			t.Fatalf("chunk %d = %#v", i, delivery)
+		}
+	}
+
+	partialBot := newScriptedDeliveryBot(0,
+		scriptedSendResult{err: errors.New("message is too long")},
+		scriptedSendResult{id: 501},
+		scriptedSendResult{err: errors.New("network unavailable")},
+	)
+	partial, partialCapture := deliveryPlatform(partialBot)
+	if err := partial.Send(context.Background(), rc, strings.Repeat("y", 9000)); err == nil {
+		t.Fatal("partial chunk send should fail")
+	}
+	got = partialCapture.get()
+	if len(got) != 1 || got[0].MessageID != "501" || got[0].PartIndex != 1 || got[0].PartCount < 2 {
+		t.Fatalf("partial deliveries = %#v", got)
+	}
+}
