+func TestMessageReceivedExtra(t *testing.T) {
+	msg := &Message{
+		MessageID:        "999",
+		ChatID:           "-100123",
+		ThreadID:         "88",
+		ReplyToMessageID: "555",
+		SenderIsBot:      true,
+		Images:           []ImageAttachment{{}},
+		Files:            []FileAttachment{{}},
+		Audio:            &AudioAttachment{},
+	}
+	extra := messageReceivedExtra(msg)
+	want := map[string]any{
+		"message_id":          "999",
+		"chat_id":             "-100123",
+		"thread_id":           "88",
+		"reply_to_message_id": "555",
+		"sender_type":         "bot",
+		"sender_is_bot":       true,
+		"has_images":          true,
+		"has_files":           true,
+		"has_audio":           true,
+	}
+	for key, value := range want {
+		if extra[key] != value {
+			t.Fatalf("%s = %#v, want %#v", key, extra[key], value)
+		}
+	}
+	if messageReceivedExtra(nil) != nil {
+		t.Fatal("nil message should produce nil metadata")
+	}
+}
