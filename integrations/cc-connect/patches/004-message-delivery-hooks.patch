+// SetDeliveryHandler registers the engine callback used to emit delivery
+// evidence. The callback is copied under lock and invoked without the lock.
+func (p *Platform) SetDeliveryHandler(handler func(core.DeliveredMessage)) {
+	p.deliveryMu.Lock()
+	p.deliveryHandler = handler
+	p.deliveryMu.Unlock()
+}
+
+func (p *Platform) reportDelivered(sent *models.Message, rc replyContext, messageType, content string, partIndex, partCount int) {
+	if sent == nil || sent.ID == 0 {
+		return
+	}
+	p.deliveryMu.RLock()
+	handler := p.deliveryHandler
+	p.deliveryMu.RUnlock()
+	if handler == nil {
+		return
+	}
+	delivery := core.DeliveredMessage{
+		MessageID:   strconv.Itoa(sent.ID),
+		ChatID:      strconv.FormatInt(rc.chatID, 10),
+		ThreadID:    optionalTelegramID(rc.threadID),
+		MessageType: messageType,
+		Content:     content,
+		PartIndex:   partIndex,
+		PartCount:   partCount,
+	}
+	func() {
+		defer func() {
+			if recovered := recover(); recovered != nil {
+				slog.Debug("telegram: delivery handler recovered", "panic", recovered)
+			}
+		}()
+		handler(delivery)
+	}()
+}
+
+func optionalTelegramID(id int) string {
+	if id == 0 {
+		return ""
+	}
+	return strconv.Itoa(id)
+}
