+func TestDeliveryReportingAttachmentsButtonsAndPreview(t *testing.T) {
+	bot := newScriptedDeliveryBot(303)
+	p, capture := deliveryPlatform(bot)
+	rc := replyContext{chatID: 42, threadID: 7}
+	if err := p.SendImage(context.Background(), rc, core.ImageAttachment{FileName: "image.png", Data: []byte("x")}); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.SendFile(context.Background(), rc, core.FileAttachment{FileName: "report.txt", Data: []byte("x")}); err != nil {
+		t.Fatal(err)
+	}
+	if err := p.SendWithButtons(context.Background(), rc, "choose", [][]core.ButtonOption{{{Text: "A", Data: "a"}}}); err != nil {
+		t.Fatal(err)
+	}
+	handle, err := p.SendPreviewStart(context.Background(), rc, "draft")
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := capture.get()
+	if len(got) != 3 || got[0].MessageType != "image" || got[1].MessageType != "file" || got[2].MessageType != "buttons" {
+		t.Fatalf("deliveries before preview finalize = %#v", got)
+	}
+	p.ReportPreviewDelivered(handle, "final")
+	got = capture.get()
+	if len(got) != 4 || got[3].MessageID != "304" || got[3].MessageType != "text" || got[3].Content != "final" {
+		t.Fatalf("deliveries after preview finalize = %#v", got)
+	}
+}
