+func TestConcurrentDeliveryReportingDoesNotReuseMessageIDs(t *testing.T) {
+	bot := newScriptedDeliveryBot(1000)
+	p, capture := deliveryPlatform(bot)
+	rc := replyContext{chatID: 42}
+	const sends = 32
+	var wg sync.WaitGroup
+	for i := 0; i < sends; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			content := fmt.Sprintf("message%d", i)
+			if err := p.Send(context.Background(), rc, content); err != nil {
+				t.Errorf("Send(%d): %v", i, err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	got := capture.get()
+	if len(got) != sends {
+		t.Fatalf("delivery count = %d, want %d", len(got), sends)
+	}
+	seen := make(map[string]bool, sends)
+	for _, delivery := range got {
+		if seen[delivery.MessageID] {
+			t.Fatalf("duplicate message id %q", delivery.MessageID)
+		}
+		seen[delivery.MessageID] = true
+		id, err := strconv.Atoi(delivery.MessageID)
+		if err != nil || bot.textFor(id) != delivery.Content {
+			t.Fatalf("message %q content mismatch: sent=%q delivered=%q", delivery.MessageID, bot.textFor(id), delivery.Content)
+		}
+	}
+}
+
+func TestDeliveryHandlerPanicCannotFailSuccessfulSend(t *testing.T) {
+	p := &Platform{bot: newScriptedDeliveryBot(600)}
+	p.SetDeliveryHandler(func(core.DeliveredMessage) { panic("hook failed") })
+	if err := p.Send(context.Background(), replyContext{chatID: 42}, "still delivered"); err != nil {
+		t.Fatalf("Send: %v", err)
+	}
+}
