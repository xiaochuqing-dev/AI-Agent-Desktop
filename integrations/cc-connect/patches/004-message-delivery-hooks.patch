+	}
+}
+
+func TestEngineDeliveryReporterEmitsExactHook(t *testing.T) {
+	received := make(chan HookEvent, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer r.Body.Close()
+		var event HookEvent
+		if err := json.NewDecoder(r.Body).Decode(&event); err != nil {
+			t.Errorf("decode hook: %v", err)
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		received <- event
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer server.Close()
+
+	p := &deliveryTestPlatform{}
+	e := NewEngine("test", nil, []Platform{p}, filepath.Join(t.TempDir(), "sessions.json"), LangEnglish)
+	e.SetHooks(NewHookManager("test", []HookConfig{{
+		Event: string(HookEventMessageSentDelivered), Type: "http", URL: server.URL, Async: boolPtr(false),
+	}}, "", "", ""))
+	p.deliver(DeliveredMessage{
+		MessageID: "777", ChatID: "-100", ThreadID: "88", MessageType: "text",
+		Content: "delivered", PartIndex: 2, PartCount: 3,
+	})
+
+	var event HookEvent
+	select {
+	case event = <-received:
+	case <-time.After(time.Second):
+		t.Fatal("delivered hook was not observed")
+	}
+	if event.Event != HookEventMessageSentDelivered || event.Platform != p.Name() || event.Content != "delivered" {
+		t.Fatalf("event = %#v", event)
+	}
+	want := map[string]any{
+		"message_id": "777", "chat_id": "-100", "thread_id": "88",
+		"message_type": "text", "part_index": float64(2), "part_count": float64(3),
+	}
+	for key, value := range want {
+		if event.Extra[key] != value {
+			t.Fatalf("extra[%q] = %#v, want %#v", key, event.Extra[key], value)
+		}
+	}
+}
+
+type previewDeliveryTestPlatform struct {
+	mu         sync.Mutex
+	updateErr  error
+	deliveries []DeliveredMessage
+}
+
+func (p *previewDeliveryTestPlatform) Name() string                             { return "preview-test" }
+func (p *previewDeliveryTestPlatform) Start(MessageHandler) error               { return nil }
+func (p *previewDeliveryTestPlatform) Reply(context.Context, any, string) error { return nil }
+func (p *previewDeliveryTestPlatform) Send(context.Context, any, string) error  { return nil }
+func (p *previewDeliveryTestPlatform) Stop() error                              { return nil }
+func (p *previewDeliveryTestPlatform) SendPreviewStart(context.Context, any, string) (any, error) {
+	return "preview-42", nil
+}
+func (p *previewDeliveryTestPlatform) UpdateMessage(context.Context, any, string) error {
+	return p.updateErr
+}
+func (p *previewDeliveryTestPlatform) KeepPreviewOnFinish() bool { return true }
+func (p *previewDeliveryTestPlatform) ReportPreviewDelivered(handle any, content string) {
+	p.mu.Lock()
+	p.deliveries = append(p.deliveries, DeliveredMessage{MessageID: handle.(string), Content: content})
+	p.mu.Unlock()
+}
+func (p *previewDeliveryTestPlatform) getDeliveries() []DeliveredMessage {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return append([]DeliveredMessage(nil), p.deliveries...)
+}
+
+func TestStreamPreviewReportsOnlySuccessfulFinalDelivery(t *testing.T) {
+	cfg := StreamPreviewCfg{Enabled: true, IntervalMs: 0, MinDeltaChars: 0, MaxChars: 2000}
+	p := &previewDeliveryTestPlatform{}
+	sp := newStreamPreview(cfg, p, nil, context.Background(), nil)
+	sp.appendText("draft")
+	if got := p.getDeliveries(); len(got) != 0 {
+		t.Fatalf("preview start reported delivery: %#v", got)
+	}
+	if !sp.finish("final", "") {
+		t.Fatal("successful final update should retain the preview")
+	}
+	if !sp.finish("final", "") {
+		t.Fatal("repeated finish should remain successful")
+	}
+	got := p.getDeliveries()
+	if len(got) != 1 || got[0].MessageID != "preview-42" || got[0].Content != "final" {
+		t.Fatalf("deliveries = %#v", got)
+	}
+
+	failing := &previewDeliveryTestPlatform{updateErr: errors.New("edit failed")}
+	failedPreview := newStreamPreview(cfg, failing, nil, context.Background(), nil)
+	failedPreview.appendText("draft")
+	if failedPreview.finish("final", "") {
+		t.Fatal("failed final update should fall back to a fresh send")
+	}
+	if got := failing.getDeliveries(); len(got) != 0 {
+		t.Fatalf("failed update reported delivery: %#v", got)
+	}
+}
