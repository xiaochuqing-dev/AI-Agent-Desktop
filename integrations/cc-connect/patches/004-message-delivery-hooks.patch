+// recordSent stores the just-delivered Telegram message_id so the engine can
+// emit a message.sent_delivered hook via LastSentMessageID().  Called by every
+// Send/SendImage/SendFile/SendWithButtons path after a successful platform send.
+func (p *Platform) recordSent(sentMsgID string, chatID int64, threadID int) {
+	if sentMsgID == "" {
+		return
+	}
+	p.lastSentMu.Lock()
+	p.lastSentMsgID = sentMsgID
+	p.lastSentChatID = strconv.FormatInt(chatID, 10)
+	if threadID != 0 {
+		p.lastSentThread = strconv.Itoa(threadID)
