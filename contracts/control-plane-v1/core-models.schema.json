{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-agent-desktop:control-plane:v1:core-models",
  "title": "AI Agent Desktop Control Plane v1 core models",
  "description": "Frozen v1 models used by the implemented read-only Control Plane foundation; mutation capabilities remain planned or unsupported.",
  "oneOf": [
    { "$ref": "#/$defs/Component" },
    { "$ref": "#/$defs/Provider" },
    { "$ref": "#/$defs/Adapter" },
    { "$ref": "#/$defs/Agent" },
    { "$ref": "#/$defs/Runtime" },
    { "$ref": "#/$defs/Channel" },
    { "$ref": "#/$defs/Conversation" },
    { "$ref": "#/$defs/Message" },
    { "$ref": "#/$defs/Task" },
    { "$ref": "#/$defs/ChildTask" },
    { "$ref": "#/$defs/TaskResult" },
    { "$ref": "#/$defs/HumanIntervention" },
    { "$ref": "#/$defs/ManagementOwner" },
    { "$ref": "#/$defs/Operation" },
    { "$ref": "#/$defs/Diagnostic" },
    { "$ref": "#/$defs/ReadinessReport" },
    { "$ref": "#/$defs/DryRunPlan" },
    { "$ref": "#/$defs/SecretRef" }
  ],
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "Revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "ResourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["system", "component", "provider", "adapter", "agent", "runtime", "channel", "conversation", "message", "task", "child_task", "operation", "diagnostic", "credential", "backup"]
        },
        "id": { "$ref": "#/$defs/Id" }
      }
    },
    "Condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "reason", "message", "observed_generation", "last_transition_time"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["true", "false", "unknown"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 128 },
        "message": { "type": "string", "maxLength": 2048 },
        "observed_generation": { "type": "integer", "minimum": 0 },
        "last_transition_time": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "version", "maturity", "availability", "constraints"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/Id" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "maturity": { "type": "string", "enum": ["stable", "experimental", "deprecated"] },
        "availability": { "type": "string", "enum": ["available", "degraded", "unavailable", "unsupported", "unknown"] },
        "constraints": { "type": "object", "additionalProperties": true }
      }
    },
    "InstallationState": {
      "type": "string",
      "enum": ["unknown", "not_installed", "installing", "installed", "uninstalling", "failed"]
    },
    "ConfigurationState": {
      "type": "string",
      "enum": ["unknown", "missing", "validating", "valid", "invalid", "conflict"]
    },
    "AuthenticationState": {
      "type": "string",
      "enum": ["unknown", "not_required", "required", "authenticating", "authenticated", "expired", "invalid"]
    },
    "RuntimeState": {
      "type": "string",
      "enum": ["unknown", "stopped", "starting", "running", "stopping", "restarting", "failed"]
    },
    "HealthState": {
      "type": "string",
      "enum": ["unknown", "checking", "healthy", "degraded", "unhealthy"]
    },
    "UpdateState": {
      "type": "string",
      "enum": ["unknown", "checking", "up_to_date", "update_available", "updating", "rollback_available", "rolling_back", "failed"]
    },
    "UserStatus": {
      "type": "string",
      "enum": ["not_installed", "installed_unconfigured", "login_required", "configuration_invalid", "starting", "running_healthy", "partially_degraded", "update_available", "start_failed", "stopped", "unknown"]
    },
    "StateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installation", "configuration", "authentication", "runtime", "health", "update", "user_status", "status_overlays", "conditions", "generation", "observed_generation", "revision", "observed_at"],
      "properties": {
        "installation": { "$ref": "#/$defs/InstallationState" },
        "configuration": { "$ref": "#/$defs/ConfigurationState" },
        "authentication": { "$ref": "#/$defs/AuthenticationState" },
        "runtime": { "$ref": "#/$defs/RuntimeState" },
        "health": { "$ref": "#/$defs/HealthState" },
        "update": { "$ref": "#/$defs/UpdateState" },
        "user_status": { "$ref": "#/$defs/UserStatus" },
        "status_overlays": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["update_available", "operation_in_progress", "drift_detected", "restart_required"] }
        },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "generation": { "type": "integer", "minimum": 0 },
        "observed_generation": { "type": "integer", "minimum": 0 },
        "revision": { "$ref": "#/$defs/Revision" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "kind", "display_name", "version", "state", "provider_refs"],
      "properties": {
        "component_id": { "$ref": "#/$defs/Id" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": ["string", "null"], "maxLength": 128 },
        "state": { "$ref": "#/$defs/StateSnapshot" },
        "provider_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } }
      }
    },
    "Provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "kind", "adapter_id", "implementation_version", "supported_contract_versions", "negotiated_contract_version", "capabilities", "state", "conditions", "observed_at"],
      "properties": {
        "provider_id": { "$ref": "#/$defs/Id" },
        "kind": { "type": "string", "enum": ["orchestration", "agent_runtime", "channel", "lifecycle", "model_configuration", "credential", "capability_registry", "human_control"] },
        "adapter_id": { "$ref": "#/$defs/Id" },
        "implementation_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "supported_contract_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "negotiated_contract_version": { "type": ["string", "null"] },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/Capability" } },
        "state": { "type": "string", "enum": ["unknown", "unavailable", "discovered", "initializing", "ready", "degraded", "error", "incompatible"] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "implementation_version", "component_refs", "provider_kinds", "state", "conditions", "observed_at"],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/Id" },
        "implementation_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "component_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "provider_kinds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["orchestration", "agent_runtime", "channel", "lifecycle", "model_configuration", "credential", "capability_registry", "human_control"] } },
        "state": { "type": "string", "enum": ["unknown", "unavailable", "initializing", "ready", "degraded", "error", "incompatible"] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AgentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "authentication", "runtime", "health", "conditions", "revision", "observed_at"],
      "properties": {
        "availability": { "type": "string", "enum": ["available", "degraded", "unavailable", "unknown"] },
        "authentication": { "$ref": "#/$defs/AuthenticationState" },
        "runtime": { "$ref": "#/$defs/RuntimeState" },
        "health": { "$ref": "#/$defs/HealthState" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "revision": { "$ref": "#/$defs/Revision" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "display_name", "runtime_ref", "roles", "capabilities", "state"],
      "properties": {
        "agent_id": { "$ref": "#/$defs/Id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "runtime_ref": { "$ref": "#/$defs/Id" },
        "roles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/Capability" } },
        "state": { "$ref": "#/$defs/AgentState" }
      }
    },
    "Runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_id", "component_id", "state", "session_capabilities", "conditions", "revision", "observed_at"],
      "properties": {
        "runtime_id": { "$ref": "#/$defs/Id" },
        "component_id": { "$ref": "#/$defs/Id" },
        "state": { "$ref": "#/$defs/RuntimeState" },
        "session_capabilities": { "type": "array", "items": { "$ref": "#/$defs/Capability" } },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "revision": { "$ref": "#/$defs/Revision" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_id", "provider_id", "display_name", "connection_state", "capabilities", "conditions", "revision", "observed_at"],
      "properties": {
        "channel_id": { "$ref": "#/$defs/Id" },
        "provider_id": { "$ref": "#/$defs/Id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "connection_state": { "type": "string", "enum": ["unknown", "disconnected", "connecting", "connected", "disconnecting", "degraded", "error"] },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/Capability" } },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "revision": { "$ref": "#/$defs/Revision" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_id", "channel_id", "scope", "participant_refs", "isolation_key"],
      "properties": {
        "conversation_id": { "$ref": "#/$defs/Id" },
        "channel_id": { "$ref": "#/$defs/Id" },
        "scope": { "type": "string", "enum": ["direct", "group", "thread", "project"] },
        "participant_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/Id" } },
        "isolation_key": { "$ref": "#/$defs/Id" }
      }
    },
    "Mention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_agent_id", "source"],
      "properties": {
        "target_agent_id": { "$ref": "#/$defs/Id" },
        "source": { "type": "string", "enum": ["native", "parsed", "command"] },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "length"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "length": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "Reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replied_to_ref"],
      "properties": {
        "replied_to_ref": { "$ref": "#/$defs/Id" },
        "replied_to_sender_ref": { "$ref": "#/$defs/Id" },
        "excerpt": { "type": "string", "maxLength": 256 }
      }
    },
    "MessageContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["text", "reference"] },
        "text": { "type": "string", "maxLength": 65536 },
        "reference": { "$ref": "#/$defs/ResourceRef" },
        "content_type": { "type": "string", "maxLength": 128 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "text" } } }, "then": { "required": ["text"] } },
        { "if": { "properties": { "kind": { "const": "reference" } } }, "then": { "required": ["reference"] } }
      ]
    },
    "Message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_ref", "conversation_id", "sender_ref", "sender_kind", "content", "mentions", "causation_id", "origin_event_id", "hop_count"],
      "properties": {
        "message_ref": { "$ref": "#/$defs/Id" },
        "conversation_id": { "$ref": "#/$defs/Id" },
        "sender_ref": { "$ref": "#/$defs/Id" },
        "sender_kind": { "type": "string", "enum": ["human", "agent", "system"] },
        "content": { "$ref": "#/$defs/MessageContent" },
        "mentions": { "type": "array", "items": { "$ref": "#/$defs/Mention" } },
        "reply": { "$ref": "#/$defs/Reply" },
        "delivery_id": { "$ref": "#/$defs/Id" },
        "causation_id": { "$ref": "#/$defs/Id" },
        "origin_event_id": { "$ref": "#/$defs/Id" },
        "hop_count": { "type": "integer", "minimum": 0 }
      }
    },
    "TaskStatus": {
      "type": "string",
      "enum": ["queued", "running", "pausing", "paused", "cancel_requested", "canceled", "succeeded", "failed"]
    },
    "Task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "pattern", "status", "target_refs", "child_task_refs", "revision", "created_at", "updated_at"],
      "properties": {
        "task_id": { "$ref": "#/$defs/Id" },
        "pattern": { "type": "string", "enum": ["single", "parallel", "sequential", "discussion"] },
        "status": { "$ref": "#/$defs/TaskStatus" },
        "target_refs": { "type": "array", "items": { "$ref": "#/$defs/ResourceRef" } },
        "child_task_refs": { "type": "array", "items": { "$ref": "#/$defs/Id" } },
        "result_ref": { "$ref": "#/$defs/Id" },
        "revision": { "$ref": "#/$defs/Revision" },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ChildTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_task_id", "parent_task_id", "agent_id", "sequence", "depends_on_previous", "status", "revision", "created_at", "updated_at"],
      "properties": {
        "child_task_id": { "$ref": "#/$defs/Id" },
        "parent_task_id": { "$ref": "#/$defs/Id" },
        "agent_id": { "$ref": "#/$defs/Id" },
        "sequence": { "type": "integer", "minimum": 0 },
        "depends_on_previous": { "type": "boolean" },
        "status": { "$ref": "#/$defs/TaskStatus" },
        "result_ref": { "$ref": "#/$defs/Id" },
        "replaces_child_task_id": { "$ref": "#/$defs/Id" },
        "revision": { "$ref": "#/$defs/Revision" },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "updated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "TaskOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_task_id", "status", "content_ref"],
      "properties": {
        "child_task_id": { "$ref": "#/$defs/Id" },
        "status": { "type": "string", "enum": ["completed", "completed_before_cancel", "partial_after_cancel"] },
        "content_ref": { "$ref": "#/$defs/Id" }
      }
    },
    "TaskFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["child_task_id", "error"],
      "properties": {
        "child_task_id": { "$ref": "#/$defs/Id" },
        "error": { "$ref": "#/$defs/UserFacingError" }
      }
    },
    "TaskResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "task_id", "status", "outputs", "failures", "completed_at"],
      "properties": {
        "result_id": { "$ref": "#/$defs/Id" },
        "task_id": { "$ref": "#/$defs/Id" },
        "status": { "type": "string", "enum": ["succeeded", "partially_succeeded", "failed", "canceled"] },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/TaskOutput" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/TaskFailure" } },
        "completed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "HumanIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "actor_ref", "actor_kind", "source", "action", "target_type", "target_id", "idempotency_key", "expected_revision", "issued_at", "causation_id"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/Id" },
        "actor_ref": { "$ref": "#/$defs/Id" },
        "actor_kind": { "const": "human" },
        "source": { "type": "string", "enum": ["local_api", "channel"] },
        "action": { "type": "string", "enum": ["pause", "resume", "cancel", "intervene", "reassign"] },
        "target_type": { "type": "string", "enum": ["task", "child_task", "agent"] },
        "target_id": { "$ref": "#/$defs/Id" },
        "payload": { "type": "object", "additionalProperties": true },
        "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256 },
        "expected_revision": { "$ref": "#/$defs/Revision" },
        "issued_at": { "$ref": "#/$defs/Timestamp" },
        "causation_id": { "$ref": "#/$defs/Id" }
      }
    },
    "ManagementOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "owner_type", "state", "revision", "since"],
      "properties": {
        "scope_id": { "$ref": "#/$defs/Id" },
        "owner_type": { "type": ["string", "null"], "enum": ["application", "official_login", "cc_switch", "external", null] },
        "state": { "type": "string", "enum": ["unassigned", "owned", "transfer_preparing", "transfer_committing", "conflict"] },
        "revision": { "$ref": "#/$defs/Revision" },
        "since": { "$ref": "#/$defs/Timestamp" },
        "transfer_id": { "$ref": "#/$defs/Id" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "unassigned" } } }, "then": { "properties": { "owner_type": { "type": "null" } } } },
        { "if": { "properties": { "state": { "enum": ["owned", "transfer_preparing", "transfer_committing"] } } }, "then": { "properties": { "owner_type": { "type": "string" } } } }
      ]
    },
    "OperationProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "message", "completed_units", "point_of_no_return"],
      "properties": {
        "phase": { "type": "string", "minLength": 1, "maxLength": 128 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "message": { "type": "string", "maxLength": 2048 },
        "completed_units": { "type": "integer", "minimum": 0 },
        "total_units": { "type": "integer", "minimum": 0 },
        "point_of_no_return": { "type": "boolean" }
      }
    },
    "UserFacingError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "recovery_actions"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "retryable": { "type": "boolean" },
        "recovery_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "diagnostic_id": { "$ref": "#/$defs/Id" },
        "operation_id": { "$ref": "#/$defs/Id" }
      }
    },
    "Operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "kind", "target_ref", "status", "progress", "idempotency_key", "created_at", "updated_at"],
      "properties": {
        "operation_id": { "$ref": "#/$defs/Id" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "target_ref": { "$ref": "#/$defs/ResourceRef" },
        "status": { "type": "string", "enum": ["queued", "running", "cancel_requested", "succeeded", "failed", "canceled"] },
        "progress": { "$ref": "#/$defs/OperationProgress" },
        "result": { "type": "object", "additionalProperties": true },
        "error": { "$ref": "#/$defs/UserFacingError" },
        "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256 },
        "deadline_at": { "$ref": "#/$defs/Timestamp" },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "updated_at": { "$ref": "#/$defs/Timestamp" },
        "completed_at": { "$ref": "#/$defs/Timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["queued", "running", "cancel_requested"] } } },
          "then": { "properties": { "result": false, "error": false, "completed_at": false } }
        },
        {
          "if": { "properties": { "status": { "const": "succeeded" } } },
          "then": { "required": ["completed_at"], "properties": { "completed_at": true, "error": false } }
        },
        {
          "if": { "properties": { "status": { "enum": ["failed", "canceled"] } } },
          "then": { "required": ["error", "completed_at"], "properties": { "error": true, "completed_at": true, "result": false } }
        }
      ]
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnostic_id", "severity", "code", "summary", "user_message", "suggested_actions", "technical_details", "redaction_applied", "created_at", "correlation_id"],
      "properties": {
        "diagnostic_id": { "$ref": "#/$defs/Id" },
        "severity": { "type": "string", "enum": ["debug", "info", "warning", "error"] },
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 512 },
        "user_message": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "suggested_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "technical_details": { "type": "object", "additionalProperties": true },
        "redaction_applied": { "type": "boolean", "const": true },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "correlation_id": { "$ref": "#/$defs/Id" },
        "operation_id": { "$ref": "#/$defs/Id" },
        "target_ref": { "$ref": "#/$defs/ResourceRef" }
      }
    },
    "SystemInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "api_version", "contract_version", "service_version", "started_at", "epoch"],
      "properties": {
        "instance_id": { "$ref": "#/$defs/Id" },
        "api_version": { "const": "v1" },
        "contract_version": { "type": "string" },
        "service_version": { "type": "string" },
        "started_at": { "$ref": "#/$defs/Timestamp" },
        "epoch": { "$ref": "#/$defs/Id" }
      }
    },
    "AuthenticationStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "state", "owner", "conditions", "revision", "observed_at"],
      "properties": {
        "component_id": { "$ref": "#/$defs/Id" },
        "state": { "$ref": "#/$defs/AuthenticationState" },
        "owner": { "type": "string", "enum": ["application", "official_login", "cc_switch", "external"] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/Condition" } },
        "revision": { "$ref": "#/$defs/Revision" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "CredentialMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_ref", "purpose", "owner", "backend", "status", "revision", "created_at", "updated_at"],
      "properties": {
        "credential_ref": { "$ref": "#/$defs/Id" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "backend": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["unknown", "stored", "valid", "invalid", "expired", "unavailable"] },
        "revision": { "$ref": "#/$defs/Revision" },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "updated_at": { "$ref": "#/$defs/Timestamp" },
        "last_validated_at": { "$ref": "#/$defs/Timestamp" },
        "expires_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "RedactedConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "scope_id", "values", "redacted_fields", "owner", "revision", "observed_at"],
      "properties": {
        "component_id": { "$ref": "#/$defs/Id" },
        "scope_id": { "$ref": "#/$defs/Id" },
        "values": { "type": "object", "additionalProperties": true },
        "redacted_fields": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "owner": { "$ref": "#/$defs/ManagementOwner" },
        "revision": { "$ref": "#/$defs/Revision" },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "LogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_entry_id", "time", "severity", "source_ref", "code", "summary", "redaction_applied", "correlation_id"],
      "properties": {
        "log_entry_id": { "$ref": "#/$defs/Id" },
        "time": { "$ref": "#/$defs/Timestamp" },
        "severity": { "type": "string", "enum": ["debug", "info", "warning", "error"] },
        "source_ref": { "$ref": "#/$defs/ResourceRef" },
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "maxLength": 2048 },
        "redaction_applied": { "type": "boolean", "const": true },
        "correlation_id": { "$ref": "#/$defs/Id" },
        "operation_id": { "$ref": "#/$defs/Id" }
      }
    },
    "Backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backup_id", "scopes", "status", "encrypted", "created_at", "revision"],
      "properties": {
        "backup_id": { "$ref": "#/$defs/Id" },
        "scopes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["program", "configuration", "credentials", "metadata"] } },
        "status": { "type": "string", "enum": ["creating", "ready", "invalid", "restoring", "failed"] },
        "encrypted": { "type": "boolean" },
        "created_at": { "$ref": "#/$defs/Timestamp" },
        "revision": { "$ref": "#/$defs/Revision" }
      }
    },
    "ControlReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "status", "control_sequence", "operation_id", "effective_state", "observed_at"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/Id" },
        "status": { "type": "string", "enum": ["accepted", "applied", "rejected", "superseded", "accepted_not_confirmed"] },
        "control_sequence": { "type": "integer", "minimum": 1 },
        "operation_id": { "$ref": "#/$defs/Id" },
        "provider_ack": { "type": "string", "maxLength": 256 },
        "effective_state": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 512 },
        "observed_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ReadinessReport": {
      "type": "object",
      "description": "Aggregated read-only readiness report from a scan. Never contains secrets. Asserts the scan did not modify the system.",
      "additionalProperties": false,
      "required": ["report_id", "scan_operation_id", "user_summary", "blockers", "warnings", "ready_items", "suggested_actions", "estimated_next_steps", "dry_run_plan", "evidence_sources", "scanned_at", "scan_version", "system_modified", "redaction_applied"],
      "properties": {
        "report_id": { "$ref": "#/$defs/Id" },
        "scan_operation_id": { "$ref": "#/$defs/Id" },
        "user_summary": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "components": { "type": "array", "items": { "$ref": "#/$defs/Component" } },
        "blockers": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/Diagnostic" } },
        "ready_items": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "suggested_actions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "estimated_next_steps": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "dry_run_plan": { "$ref": "#/$defs/DryRunPlan" },
        "evidence_sources": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "scanned_at": { "$ref": "#/$defs/Timestamp" },
        "scan_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "system_modified": { "type": "boolean", "const": false },
        "redaction_applied": { "type": "boolean", "const": true }
      }
    },
    "DryRunPlan": {
      "type": "object",
      "description": "Planned-only action plan generated by a scan. execute is always false in the readiness slice; no action is performed.",
      "additionalProperties": false,
      "required": ["plan_id", "operation_id", "execute", "status", "actions", "generated_at"],
      "properties": {
        "plan_id": { "$ref": "#/$defs/Id" },
        "operation_id": { "$ref": "#/$defs/Id" },
        "execute": { "type": "boolean", "const": false },
        "status": { "type": "string", "const": "planned" },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/DryRunAction" } },
        "generated_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "DryRunAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_id", "component_id", "action_type", "reason", "prerequisites", "requires_admin", "requires_user_interaction", "secret_required", "estimated_risk", "reversible", "rollback_hint", "status"],
      "properties": {
        "action_id": { "$ref": "#/$defs/Id" },
        "component_id": { "$ref": "#/$defs/Id" },
        "action_type": { "type": "string", "enum": ["install", "configure", "authenticate", "start", "stop", "restart", "update", "rollback", "transfer_owner", "migrate"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 },
        "prerequisites": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 256 } },
        "requires_admin": { "type": "boolean" },
        "requires_user_interaction": { "type": "boolean" },
        "secret_required": { "type": "boolean" },
        "estimated_risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "reversible": { "type": "boolean" },
        "rollback_hint": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "const": "planned" }
      }
    },
    "SecretRef": {
      "type": "object",
      "description": "A reference to a stored secret. Never carries a value or value fragment. Readiness scan only checks existence or accessibility.",
      "additionalProperties": false,
      "required": ["secret_ref_id", "credential_ref", "purpose", "owner", "backend", "status", "redacted"],
      "properties": {
        "secret_ref_id": { "$ref": "#/$defs/Id" },
        "credential_ref": { "$ref": "#/$defs/Id" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 128 },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "backend": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["unknown", "stored", "valid", "invalid", "expired", "unavailable"] },
        "exists": { "type": ["boolean", "null"] },
        "redacted": { "type": "boolean", "const": true }
      }
    }
  }
}
