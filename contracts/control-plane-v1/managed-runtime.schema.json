{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-agent-desktop.local/contracts/control-plane-v1/managed-runtime.schema.json",
  "title": "AI Agent Desktop cc-connect managed runtime models",
  "description": "Non-secret configuration plans, explicit lifecycle ownership, process identity, port ownership, health, update assessment, and external-tool boundaries.",
  "oneOf": [
    { "$ref": "#/$defs/ManagedConfiguration" },
    { "$ref": "#/$defs/ConfigurationPlan" },
    { "$ref": "#/$defs/ConfigurationState" },
    { "$ref": "#/$defs/OwnershipPlan" },
    { "$ref": "#/$defs/ProcessIdentity" },
    { "$ref": "#/$defs/PortOwnershipEvidence" },
    { "$ref": "#/$defs/LifecycleRuntimeStatus" },
    { "$ref": "#/$defs/UpdateAssessment" },
    { "$ref": "#/$defs/ExternalToolStatus" }
  ],
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ManagementOwnerValue": {
      "type": "string",
      "enum": ["external", "product", "unmanaged", "conflict", "unknown"]
    },
    "LifecycleOwnerValue": {
      "type": "string",
      "enum": ["external", "product", "none", "conflict", "unknown"]
    },
    "ManagedSecretRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "backend", "purpose", "required"],
      "properties": {
        "reference_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$" },
        "backend": { "type": "string", "enum": ["windows_credential_manager", "memory"] },
        "purpose": { "type": "string", "enum": ["telegram_bot_token", "agent_api_key"] },
        "required": { "type": "boolean" }
      }
    },
    "ManagedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "component_id", "artifact_id", "product_instance_id",
        "listen_host", "listen_port", "data_dir", "log_dir", "project_root",
        "lifecycle_owner", "management_owner", "configuration_revision",
        "created_at", "updated_at", "secret_refs", "telegram", "network_mode",
        "health_probe"
      ],
      "properties": {
        "schema_version": { "const": "1.0" },
        "component_id": { "const": "cc-connect" },
        "artifact_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "product_instance_id": { "type": "string", "pattern": "^instance-[a-f0-9]{24}$" },
        "listen_host": { "const": "127.0.0.1" },
        "listen_port": { "type": "integer", "minimum": 59000, "maximum": 59999 },
        "data_dir": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "log_dir": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "project_root": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "lifecycle_owner": { "const": "product" },
        "management_owner": { "const": "product" },
        "configuration_revision": { "type": "integer", "minimum": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "secret_refs": { "type": "array", "items": { "$ref": "#/$defs/ManagedSecretRef" } },
        "telegram": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "mode"],
          "properties": {
            "enabled": { "const": false },
            "mode": { "const": "disabled" }
          }
        },
        "network_mode": { "const": "loopback_only" },
        "health_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup_timeout_seconds", "stable_window_seconds", "local_endpoint_supported", "deep_health"],
          "properties": {
            "startup_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
            "stable_window_seconds": { "type": "integer", "minimum": 1, "maximum": 60 },
            "local_endpoint_supported": { "const": false },
            "deep_health": { "const": "unsupported" }
          }
        }
      }
    },
    "ConfigurationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id", "plan_digest", "context_digest", "component_id", "artifact_id",
        "current_revision", "target_revision", "current_owner", "target_owner",
        "lifecycle_owner", "target_path", "expected_changes", "ports", "directories",
        "secret_refs", "risk", "rollback_plan", "user_confirmation_required",
        "created_at", "expires_at"
      ],
      "properties": {
        "plan_id": { "type": "string", "minLength": 1 },
        "plan_digest": { "$ref": "#/$defs/Digest" },
        "context_digest": { "$ref": "#/$defs/Digest" },
        "component_id": { "const": "cc-connect" },
        "artifact_id": { "type": "string", "minLength": 1 },
        "current_revision": { "type": "integer", "minimum": 0 },
        "target_revision": { "type": "integer", "minimum": 1 },
        "current_owner": { "$ref": "#/$defs/ManagementOwnerValue" },
        "target_owner": { "const": "product" },
        "lifecycle_owner": { "const": "product" },
        "target_path": { "const": "state/config/cc-connect.managed.toml" },
        "expected_changes": { "type": "array", "items": { "type": "string" } },
        "ports": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "type": "integer", "minimum": 59000, "maximum": 59999 } },
        "directories": { "type": "array", "items": { "type": "string" } },
        "secret_refs": { "type": "array", "items": { "$ref": "#/$defs/ManagedSecretRef" } },
        "risk": { "const": "medium" },
        "rollback_plan": { "type": "array", "items": { "type": "string" } },
        "rollback_to_revision": { "type": ["integer", "null"], "minimum": 1 },
        "user_confirmation_required": { "const": true },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "ConfigurationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "status", "revision", "relative_path", "management_owner", "lifecycle_owner", "secret_status"],
      "properties": {
        "component_id": { "const": "cc-connect" },
        "status": { "type": "string", "enum": ["missing", "valid", "drifted", "invalid", "pending_repair"] },
        "revision": { "type": "integer", "minimum": 0 },
        "digest": { "type": ["string", "null"] },
        "relative_path": { "const": "state/config/cc-connect.managed.toml" },
        "management_owner": { "$ref": "#/$defs/ManagementOwnerValue" },
        "lifecycle_owner": { "$ref": "#/$defs/LifecycleOwnerValue" },
        "configuration": { "oneOf": [{ "$ref": "#/$defs/ManagedConfiguration" }, { "type": "null" }] },
        "secret_status": { "type": "object", "additionalProperties": { "type": "string", "enum": ["missing", "available", "inaccessible", "unknown"] } },
        "diagnostic_code": { "type": ["string", "null"] }
      }
    },
    "OwnershipPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id", "plan_digest", "context_digest", "component_id", "artifact_id",
        "current_management_owner", "target_management_owner", "current_lifecycle_owner",
        "target_lifecycle_owner", "external_process_detected", "expected_changes", "risk",
        "rollback_plan", "user_confirmation_required", "created_at", "expires_at"
      ],
      "properties": {
        "plan_id": { "type": "string" },
        "plan_digest": { "$ref": "#/$defs/Digest" },
        "context_digest": { "$ref": "#/$defs/Digest" },
        "component_id": { "const": "cc-connect" },
        "artifact_id": { "type": "string" },
        "current_management_owner": { "$ref": "#/$defs/ManagementOwnerValue" },
        "target_management_owner": { "const": "product" },
        "current_lifecycle_owner": { "$ref": "#/$defs/LifecycleOwnerValue" },
        "target_lifecycle_owner": { "const": "product" },
        "external_process_detected": { "const": false },
        "expected_changes": { "type": "array", "items": { "type": "string" } },
        "risk": { "const": "medium" },
        "rollback_plan": { "type": "array", "items": { "type": "string" } },
        "user_confirmation_required": { "const": true },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "ProcessIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id", "product_instance_id", "artifact_id", "executable_path",
        "executable_sha256", "pid", "process_create_time", "parent_pid",
        "start_command_digest", "configuration_revision", "listen_host", "listen_port",
        "lifecycle_owner", "operation_id"
      ],
      "properties": {
        "component_id": { "const": "cc-connect" },
        "product_instance_id": { "type": "string" },
        "artifact_id": { "type": "string" },
        "executable_path": { "type": "string" },
        "executable_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "pid": { "type": "integer", "minimum": 1 },
        "process_create_time": { "type": "string" },
        "parent_pid": { "type": "integer", "minimum": 0 },
        "start_command_digest": { "$ref": "#/$defs/Digest" },
        "configuration_revision": { "type": "integer", "minimum": 1 },
        "listen_host": { "const": "127.0.0.1" },
        "listen_port": { "type": "integer", "minimum": 59000, "maximum": 59999 },
        "lifecycle_owner": { "const": "product" },
        "operation_id": { "type": "string" }
      }
    },
    "PortOwnershipEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen_host", "listen_port", "status", "ipv6_status", "evidence"],
      "properties": {
        "listen_host": { "const": "127.0.0.1" },
        "listen_port": { "type": "integer", "minimum": 59000, "maximum": 59999 },
        "status": { "type": "string", "enum": ["free", "owned", "conflict", "not_listening", "unknown"] },
        "owner_pid": { "type": ["integer", "null"] },
        "expected_pid": { "type": ["integer", "null"] },
        "ipv6_status": { "type": "string", "enum": ["unsupported", "unknown"] },
        "evidence": { "type": "object" }
      }
    },
    "RuntimeHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall", "process_identity_verified", "artifact_integrity_verified",
        "configuration_revision_verified", "port_owned_by_process",
        "startup_stable_for_window", "local_endpoint_verified", "local_endpoint_status",
        "deep_health", "fatal_log_detected"
      ],
      "properties": {
        "overall": { "type": "string", "enum": ["stopped", "starting", "partial", "unhealthy", "unknown"] },
        "process_identity_verified": { "type": "boolean" },
        "artifact_integrity_verified": { "type": "boolean" },
        "configuration_revision_verified": { "type": "boolean" },
        "port_owned_by_process": { "type": "boolean" },
        "startup_stable_for_window": { "type": "boolean" },
        "local_endpoint_verified": { "const": false },
        "local_endpoint_status": { "const": "unsupported" },
        "deep_health": { "const": "unsupported" },
        "fatal_log_detected": { "type": "boolean" }
      }
    },
    "LifecycleRuntimeStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id", "configuration_revision", "expected_state", "observed_state",
        "management_owner", "lifecycle_owner", "health", "updated_at"
      ],
      "properties": {
        "component_id": { "const": "cc-connect" },
        "product_instance_id": { "type": ["string", "null"] },
        "artifact_id": { "type": ["string", "null"] },
        "configuration_revision": { "type": "integer", "minimum": 0 },
        "expected_state": { "type": "string", "enum": ["running", "stopped"] },
        "observed_state": { "type": "string", "enum": ["unconfigured", "stopped", "starting", "running_partial", "crashed", "conflict", "unknown"] },
        "management_owner": { "$ref": "#/$defs/ManagementOwnerValue" },
        "lifecycle_owner": { "$ref": "#/$defs/LifecycleOwnerValue" },
        "pid": { "type": ["integer", "null"] },
        "identity": { "oneOf": [{ "$ref": "#/$defs/ProcessIdentity" }, { "type": "null" }] },
        "identity_verification": { "type": ["object", "null"] },
        "port_ownership": { "oneOf": [{ "$ref": "#/$defs/PortOwnershipEvidence" }, { "type": "null" }] },
        "health": { "$ref": "#/$defs/RuntimeHealth" },
        "last_exit_code": { "type": ["integer", "null"] },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "UpdateAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment_id", "component_id", "status", "compatibility", "migration", "automatic_update_performed", "upstream_patch_modified"],
      "properties": {
        "assessment_id": { "type": "string" },
        "component_id": { "type": "string" },
        "current_version": { "type": ["object", "null"] },
        "target_version": { "type": ["object", "null"] },
        "status": { "type": "string", "enum": ["compatible", "already_current", "unsupported", "unknown"] },
        "compatibility": { "type": "array", "items": { "type": "object" } },
        "migration": { "type": "object" },
        "rollback_version": { "type": ["object", "null"] },
        "automatic_update_performed": { "const": false },
        "upstream_patch_modified": { "const": false }
      }
    },
    "ExternalToolStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "display_name", "installation_status", "supported_agents", "capabilities", "lifecycle_owner", "management_owner", "last_verified_at", "evidence"],
      "properties": {
        "provider_id": { "type": "string" },
        "display_name": { "type": "string" },
        "installation_status": { "type": "string", "enum": ["installed", "not_installed", "unknown"] },
        "executable_path": { "type": ["string", "null"] },
        "version": { "type": ["string", "null"] },
        "supported_agents": { "type": "array", "items": { "type": "string" } },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "status", "evidence"],
            "properties": {
              "capability": { "type": "string" },
              "status": { "type": "string", "enum": ["supported", "unavailable", "unknown"] },
              "evidence": { "type": "string" }
            }
          }
        },
        "lifecycle_owner": { "const": "external" },
        "management_owner": { "const": "external" },
        "last_verified_at": { "type": "string", "format": "date-time" },
        "evidence": { "type": "object" }
      }
    }
  }
}
